@model UbthIctTicketing.Models.Incident

@{
    ViewData["Title"] = $"Incident Details #{Model.Id}";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>ICT Incident Ticket #@Model.Id</h2>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">← Back to Ticket List</a>
            <a asp-action="Dashboard" class="btn btn-outline-primary">Analytics Dashboard</a>
        </div>
    </div>

    <!-- Step 1: Initial Incident Report -->
    <div class="card mb-4 border-danger shadow-sm">
        <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">🔴 ICT INCIDENT REPORT</h5>
            <span class="badge bg-light text-dark">
                Priority: @Model.Priority
            </span>
        </div>
        <div class="card-body">
            <div class="row mb-2">
                <div class="col-md-4">
                    <strong>Department:</strong>
                    <p class="mb-0">@Model.Department</p>
                </div>
                <div class="col-md-4">
                    <strong>Office / Location:</strong>
                    <p class="mb-0">@Model.Office</p>
                </div>
                <div class="col-md-4">
                    <strong>Reported By:</strong>
                    <p class="mb-0">@Model.ReportedBy (@Model.ReportedTime.ToString("g"))</p>
                </div>
            </div>
            <div class="mt-3">
                <strong>Issue Description:</strong>
                <p class="p-2 bg-light border rounded mt-1 mb-0">@Model.Issue</p>
            </div>

            <!-- Framed Image Display directly on the Ticket -->
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="mt-4">
                    <strong>Attached Incident Frame:</strong>
                    <div class="p-3 bg-light border rounded text-center mt-2">
                        <div class="d-inline-block p-2 bg-white rounded shadow-sm border">
                            <img src="@Model.ImagePath" alt="Incident Attachment" class="img-fluid rounded" style="max-height: 400px; width: auto;" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Step 2: Support Assignment / Response -->
    <div class="card mb-4 border-warning shadow-sm">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <h5 class="mb-0">✔ SUPPORT ACKNOWLEDGEMENT & ASSIGNMENT</h5>
            <span class="badge @(Model.Status == UbthIctTicketing.Models.IncidentStatus.Reported ? "bg-secondary" : "bg-info text-dark")">
                Status: @Model.Status
            </span>
        </div>
        <div class="card-body">
            @if (Model.Status == UbthIctTicketing.Models.IncidentStatus.Reported)
            {
                <div class="alert alert-warning mb-0">
                    <em>This incident has not been assigned to a support/networking staff yet.</em>
                </div>
            }
            else
            {
                <div class="row mb-2">
                    <div class="col-md-4">
                        <strong>Assigned Team:</strong>
                        <p class="mb-0">@(Model.AssignedTeam ?? "N/A")</p>
                    </div>
                    <div class="col-md-4">
                        <strong>Assigned Support:</strong>
                        <p class="mb-0">@(Model.AssignedEngineer ?? "N/A")</p>
                    </div>
                    <div class="col-md-4">
                        <strong>ETA:</strong>
                        <p class="mb-0">@(Model.EstimatedTime ?? "N/A")</p>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.InitialEngineerReply))
                {
                    <div class="mt-3">
                        <strong>System Reply Log:</strong>
                        <p class="p-2 bg-light border rounded mt-1 mb-0">@Model.InitialEngineerReply</p>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Step 3: Incident Closure & Resolution -->
    <div class="card mb-4 border-success shadow-sm">
        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">✔ INCIDENT RESOLUTION & CLOSURE</h5>
            @if (Model.Status == UbthIctTicketing.Models.IncidentStatus.Closed)
            {
                <span class="badge bg-light text-success">CLOSED</span>
            }
        </div>
        <div class="card-body">
            @if (Model.Status == UbthIctTicketing.Models.IncidentStatus.Closed)
            {
                <div class="row mb-2">
                    <div class="col-md-4">
                        <strong>Resolving Support:</strong>
                        <p class="mb-0">@Model.AssignedEngineer</p>
                    </div>
                    <div class="col-md-4">
                        <strong>Time Completed:</strong>
                        <p class="mb-0">@Model.TimeCompleted?.ToString("g")</p>
                    </div>
                    <div class="col-md-4">
                        <strong>Confirmed By:</strong>
                        <p class="mb-0">@Model.ConfirmedBy</p>
                    </div>
                </div>
                <div class="mt-3">
                    <strong>Resolution Details:</strong>
                    <p class="p-2 bg-light border rounded mt-1 mb-0">@Model.Resolution</p>
                </div>
            }
            else
            {
                <div class="alert alert-secondary mb-0">
                    <em>This ticket is still open. Resolution details will appear here once the ticket is marked resolved and confirmed.</em>
                </div>
            }
        </div>
    </div>
</div>