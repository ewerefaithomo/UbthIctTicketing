@model UbthIctTicketing.Models.Incident

@{
    ViewData["Title"] = "Report ICT Incident";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">🔴 Log New ICT Incident</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row mb-3">
                        <!-- Department Combo Box (Select List) -->
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label fw-bold"></label>
                            <select asp-for="Department" class="form-select" required>
                                <option value="">-- Select Department / Unit --</option>
